{
  "name": "llm-architecture-comparison",
  "version": "1.0.0",
  "description": "Comparing package by feature vs layered architecture for LLM interaction",
  "scripts": {
    "build": "tsc",
    "start:feature": "node dist/feature-based/index.js",
    "start:layered": "node dist/layered/index.js",
    "dev:feature": "ts-node feature-based/src/index.ts",
    "dev:layered": "ts-node layered/src/index.ts",
    "test": "jest",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.8.10",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "express": "^4.18.2",
    "zod": "^3.22.4"
  }
}
